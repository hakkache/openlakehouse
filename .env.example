# =============================================================================
# OPENLAKEHOUSE - Environment Configuration (example)
# Copy this file to .env and adjust values before starting the platform.
# =============================================================================

# ---------- General ----------
COMPOSE_PROJECT_NAME=openlakehouse
DOMAIN=localhost
TZ=UTC

# ---------- PostgreSQL (control plane) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=openlakehouse
POSTGRES_USER=openlakehouse
POSTGRES_PASSWORD=openlakehouse_dev_password

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MinIO (S3 compatible storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# ---------- Backend (FastAPI control plane) ----------
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change_me_dev_secret_key
BACKEND_ENV=development
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=openlakehouse
VITE_KEYCLOAK_CLIENT_ID=openlakehouse-web

# ---------- Traefik ----------
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ---------- Keycloak (Phase 2) ----------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=openlakehouse

# ---------- OpenBao (Phase 2) ----------
OPENBAO_PORT=8200
OPENBAO_ROOT_TOKEN=dev-root-token

# ---------- Polaris / Iceberg REST catalog (Phase 3) ----------
POLARIS_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_ROOT_SECRET=polaris_dev_secret

# ---------- Spark (Phase 3) ----------
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER_UI_PORT=8091
SPARK_HISTORY_PORT=18080
SPARK_THRIFT_PORT=10001

# ---------- Jupyter (Phase 4) ----------
JUPYTER_PORT=8888
JUPYTER_TOKEN=openlakehouse
VITE_JUPYTER_URL=/jupyter
VITE_JUPYTER_TOKEN=openlakehouse

# ---------- Trino (Phase 5) ----------
TRINO_PORT=8082

